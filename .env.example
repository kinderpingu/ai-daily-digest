# ──────────────────────────────────────────────────────────────────────────────
# Daily Digest Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenRouter ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=paste the key
# OpenRouter model; change this without modifying the code.
OPENROUTER_MODEL=openrouter/auto:free

# ── Topics (comma-separated) ───────────────────────────────────────────────────
# Change these to whatever you want to track daily
DIGEST_TOPICS=artificial intelligence,open source software,developer tools,startup news

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Delivery: artifact is the default for GitLab testing; smtp enables email.
DELIVERY_MODE=artifact
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_SUBJECT_PREFIX=📰 Daily Digest

# ── Behaviour ──────────────────────────────────────────────────────────────────
MAX_ARTICLES_PER_TOPIC=3
MAX_ITERATIONS=12
MAX_SEARCHES=12
MAX_FETCHES=18
SAVE_MARKDOWN=true
TIMEZONE=Europe/Rome
