# ──────────────────────────────────────────────────────────────────────────────
# Daily Digest Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenRouter ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=paste the key
# Default model — Hermes 3 on Llama 3.1 405B (best quality)
# Cheaper option: nousresearch/hermes-3-llama-3.1-70b
HERMES_MODEL=openrouter/auto:free

# ── Topics (comma-separated) ───────────────────────────────────────────────────
# Change these to whatever you want to track daily
DIGEST_TOPICS=artificial intelligence,open source software,developer tools,startup news

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Gmail: use an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_SUBJECT_PREFIX=📰 Daily Digest

# ── Behaviour ──────────────────────────────────────────────────────────────────
MAX_ARTICLES_PER_TOPIC=3
SAVE_MARKDOWN=true
